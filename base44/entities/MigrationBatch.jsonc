{
  "name": "MigrationBatch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Migration batch name"
    },
    "source_azure_tenant_id": {
      "type": "string",
      "description": "Azure Tenant GUID being migrated FROM"
    },
    "source_tenant_name": {
      "type": "string"
    },
    "target_azure_tenant_id": {
      "type": "string",
      "description": "Azure Tenant GUID being migrated TO"
    },
    "target_tenant_name": {
      "type": "string"
    },
    "workloads": {
      "type": "string",
      "description": "Comma-separated: mailboxes,onedrive,sharepoint,teams,users,groups"
    },
    "payload_file_uri": {
      "type": "string",
      "description": "Private storage uri of the batch inputs JSON (selection, mappings, rules, copy settings) \u2014 these are too large for a record field"
    },
    "selection": {
      "type": "string",
      "description": "JSON array of migration items {kind, source, target} \u2014 legacy batches only, new batches keep this in payload_file_uri"
    },
    "user_mapping": {
      "type": "string",
      "description": "JSON array of user mappings \u2014 legacy batches only, new batches keep this in payload_file_uri"
    },
    "group_mapping": {
      "type": "string",
      "description": "JSON array of group mappings \u2014 legacy batches only, new batches keep this in payload_file_uri"
    },
    "principal_replace_rules": {
      "type": "string",
      "description": "JSON array of {find, replace} principal replacement rules \u2014 legacy batches only, new batches keep this in payload_file_uri"
    },
    "copy_settings": {
      "type": "string",
      "description": "JSON of per-workload copy settings \u2014 legacy batches only, new batches keep this in payload_file_uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "paused",
        "completed",
        "failed"
      ],
      "default": "planned"
    },
    "progress": {
      "type": "string",
      "description": "JSON {done, succeeded, failed, skipped} summary counts"
    },
    "progress_file_uri": {
      "type": "string",
      "description": "Private storage uri of the per-item progress log JSON, keyed by item index"
    },
    "cursor": {
      "type": "number",
      "default": 0
    },
    "incremental": {
      "type": "boolean",
      "default": false
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "source_azure_tenant_id",
    "target_azure_tenant_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}