{
  "name": "TenantCredential",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Friendly name shown in pickers, e.g. 'Contoso - migration app registration'"
    },
    "role": {
      "type": "string",
      "enum": [
        "source",
        "destination",
        "both"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "both",
      "description": "Which side of a migration this account is used for"
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "interactive",
        "credential",
        "app_registration",
        "windows_integrated"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green"
      ],
      "default": "app_registration",
      "description": "How the account signs in"
    },
    "azure_tenant_id": {
      "type": "string",
      "description": "Azure tenant GUID this account belongs to"
    },
    "domain": {
      "type": "string",
      "description": "Primary domain of the tenant, e.g. contoso.com"
    },
    "client_id": {
      "type": "string",
      "description": "Application (client) ID for app registration sign-in"
    },
    "client_secret": {
      "type": "string",
      "description": "Application client secret"
    },
    "username": {
      "type": "string",
      "description": "UPN for username and password sign-in"
    },
    "password": {
      "type": "string",
      "description": "Password for username and password sign-in"
    },
    "notes": {
      "type": "string",
      "description": "Scope, permission or rotation notes"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}