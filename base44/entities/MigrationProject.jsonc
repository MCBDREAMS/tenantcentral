{
  "name": "MigrationProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Friendly migration project name"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "sharepoint_onprem",
        "sharepoint_online",
        "file_share",
        "google_workspace",
        "box",
        "m365_tenant"
      ],
      "enumColors": [
        "purple",
        "blue",
        "gray",
        "blue",
        "pink",
        "green"
      ],
      "default": "sharepoint_onprem",
      "description": "Where the content is coming from"
    },
    "source_endpoint": {
      "type": "string",
      "description": "Source URL, UNC path, domain or tenant domain"
    },
    "source_label": {
      "type": "string",
      "description": "Human readable source summary shown in lists"
    },
    "source_notes": {
      "type": "string",
      "description": "Credentials model, agent host, proxy or scope notes"
    },
    "source_tenant_id": {
      "type": "string",
      "description": "Base44 Tenant record id of a Microsoft 365 source used for the in-app run"
    },
    "source_azure_tenant_id": {
      "type": "string",
      "description": "Azure tenant GUID of the Microsoft 365 source used for the in-app run"
    },
    "source_tenant_name": {
      "type": "string"
    },
    "source_auth": {
      "type": "string",
      "description": "JSON sign-in settings for the source system: {method, username, password, client_id, client_secret}"
    },
    "target_auth": {
      "type": "string",
      "description": "JSON sign-in settings for the destination tenant: {method, username, password, client_id, client_secret}"
    },
    "target_tenant_id": {
      "type": "string",
      "description": "Base44 Tenant record id being migrated into"
    },
    "target_tenant_name": {
      "type": "string"
    },
    "target_azure_tenant_id": {
      "type": "string",
      "description": "Azure tenant GUID of the destination tenant"
    },
    "target_domain": {
      "type": "string"
    },
    "workloads": {
      "type": "string",
      "description": "Comma separated: sharepoint,onedrive,teams,exchange"
    },
    "mode": {
      "type": "string",
      "enum": [
        "standard",
        "insane"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "standard",
      "description": "standard copies direct; insane stages through Azure storage to bypass throttling"
    },
    "staging_account": {
      "type": "string",
      "description": "Azure storage account used as the insane mode intermediary"
    },
    "staging_container": {
      "type": "string",
      "default": "migration-staging"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "running",
        "completed",
        "failed"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "draft"
    },
    "native_batch_id": {
      "type": "string",
      "description": "MigrationBatch record id used by the in-app run, so the live dashboard reopens"
    },
    "item_count": {
      "type": "number",
      "default": 0,
      "description": "Items counted by the last discovery scan"
    },
    "prescan_summary": {
      "type": "string",
      "description": "JSON severity counts from the pre-migration scan"
    },
    "prescan_findings": {
      "type": "string",
      "description": "JSON array of pre-migration findings (capped)"
    },
    "postcheck_summary": {
      "type": "string",
      "description": "JSON counts from the post-migration comparison"
    },
    "postcheck_findings": {
      "type": "string",
      "description": "JSON array of post-migration drift findings (capped)"
    },
    "audit_log": {
      "type": "string",
      "description": "JSON array of project audit events"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "source_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}